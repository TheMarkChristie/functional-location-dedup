<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XrmToolBox plugin: Functional Location De-duplicator.
    Thin WebView2 host around the shared prx3_FunctionalLocationMerge.html.
    Targets .NET Framework 4.8 (required by XrmToolBox).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FunctionalLocationMerge</AssemblyName>
    <RootNamespace>FunctionalLocationMerge</RootNamespace>
    <!-- XrmToolBox discovers plugins by the *.dll naming convention below -->
    <Product>Functional Location De-duplicator</Product>
    <Company>Mark Christie</Company>
    <Authors>Mark Christie</Authors>
    <Version>1.0.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- XrmToolBox plugin SDK + Dataverse client -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.1.32" />
    <!-- Embedded Chromium for hosting the HTML app (match XrmToolBoxPackage's WebView2) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <!-- refresh app\functional-location-dedup.html from the canonical HTML before each build -->
  <Target Name="BuildApp" BeforeTargets="BeforeBuild">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\build-app.js&quot;" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <!-- Ship the app HTML next to the dll so WebView2 can load it. The file name must stay
         UNIQUE: every plugin dll installs flat into Plugins, so all WebView2 tools share the
         one Plugins\app folder and a generic index.html is silently overwritten by whichever
         tool installs last. -->
    <None Include="app\functional-location-dedup.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
